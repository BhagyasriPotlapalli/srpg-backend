PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/sr-pg?retryWrites=true&w=majority
# MONGODB_URI=mongodb://127.0.0.1:27017/sr_pg_management

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Admin Credentials for Seeding
ADMIN_NAME=SR PG Admin
ADMIN_EMAIL=admin@srpg.com
ADMIN_PASSWORD=Admin@123456
